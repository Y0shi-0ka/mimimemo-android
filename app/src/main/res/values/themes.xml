<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      バーは背景と同じ色にして、重い帯を置かない（issue #35）。
      ステータスバー・ナビゲーションバーも背景色にそろえる（文字の明暗は bools.xml）。
    -->
    <style name="Theme.MimiMemo" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondaryContainer">@color/primary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_primary_container</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/background</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerLowest">@color/card</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/card_stroke</item>
        <item name="actionBarStyle">@style/MimiMemo.ActionBar</item>
        <item name="actionBarTheme">@style/MimiMemo.ActionBarTheme</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="materialAlertDialogTheme">@style/MimiMemo.Dialog</item>
    </style>

    <style name="MimiMemo.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/background</item>
        <item name="elevation">0dp</item>
        <item name="titleTextStyle">@style/MimiMemo.ActionBar.Title</item>
    </style>

    <style name="MimiMemo.ActionBarTheme" parent="ThemeOverlay.Material3.ActionBar">
        <item name="colorControlNormal">@color/on_surface</item>
        <!-- 右上のメニューもカードと同じ面の色にする -->
        <item name="colorSurfaceContainer">@color/card</item>
    </style>

    <style name="MimiMemo.ActionBar.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 一覧のカード：白い面に細い枠線。影は付けない -->
    <style name="MimiMemo.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/card</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ダイアログ：カードと同じ面の色で、角を大きく -->
    <style name="MimiMemo.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurfaceContainerHigh">@color/card</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/MimiMemo.Corner28</item>
    </style>

    <style name="MimiMemo.Corner28" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="MimiMemo.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- 期限・タグの小さな札 -->
    <style name="MimiMemo.Pill" parent="">
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="MimiMemo.SectionTitle" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
