<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 動作中であることを常に表示する（プライバシー方針①）。丸い札に点と状態（issue #35） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="18dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="@color/idle" />

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:maxLines="1"
                android:text="@string/status_starting"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ためている文があるときだけ出す。5分待たずにまとめて調べる（issue #36） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonFlush"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_flush"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 聞き取れないとき（モデルがない・許可がない・使えない端末）だけ、理由とできる操作を出す -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/noticeCard"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:cardCornerRadius="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnPrimaryContainer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 確認待ちの ToDo 候補（issue #33）：カードを右へ払うと追加、左で追加しない、タップで詳細 -->
    <LinearLayout
        android:id="@+id/candidateArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:visibility="gone">

        <jp.mimimemo.CandidateStackView
            android:id="@+id/candidateStack"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="20dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/buttonSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="40dp"
                android:contentDescription="@string/candidate_reject"
                android:src="@drawable/ic_close"
                app:backgroundTint="@color/card"
                app:elevation="4dp"
                app:fabCustomSize="68dp"
                app:maxImageSize="30dp"
                app:shapeAppearanceOverlay="@style/MimiMemo.Circle"
                app:tint="@color/swipe_neutral" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/buttonAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/swipe_add"
                android:src="@drawable/ic_check"
                app:backgroundTint="@color/swipe_positive"
                app:elevation="4dp"
                app:fabCustomSize="68dp"
                app:maxImageSize="32dp"
                app:shapeAppearanceOverlay="@style/MimiMemo.Circle"
                app:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollTranscript"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textTranscript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/transcript_hint"
                android:lineSpacingMultiplier="1.4"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <TextView
                android:id="@+id/textPartial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </ScrollView>

    <!-- 聞き取れないときだけ出す。文を打つと、聞き取ったときと同じ流れで候補を探す -->
    <LinearLayout
        android:id="@+id/manualRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/manual_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSend"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSend"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_send"
            android:padding="0dp"
            app:icon="@drawable/ic_send"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />
    </LinearLayout>

    <!-- 主役は候補カードなので、停止は控えめな色にする（issue #35） -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonStop"
        style="@style/Widget.Material3.Button.TonalButton.Icon"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/action_stop"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface"
        app:backgroundTint="@color/surface_container"
        app:cornerRadius="28dp"
        app:icon="@drawable/ic_stop"
        app:iconGravity="textStart"
        app:iconTint="?attr/colorOnSurface" />
</LinearLayout>
