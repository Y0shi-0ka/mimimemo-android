<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 明日が期限の ToDo があるときだけ出す -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/reminderCard"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/due_urgent_bg"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp"
                android:paddingStart="16dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/reminderText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/due_urgent_fg"
                    android:textStyle="bold" />

                <!-- 文が折り返さないよう、読み上げはアイコンだけのボタンにする（issue #35） -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSpeakReminder"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/action_speak"
                    android:padding="0dp"
                    app:icon="@drawable/ic_volume"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/due_urgent_fg" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- タグで絞り込んでいるときだけ出す。押すと全部に戻す（#109） -->
        <com.google.android.material.chip.Chip
            android:id="@+id/filterChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:closeIconVisible="true" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <!-- 1件もないときだけ出す。マイクの絵と一言だけ（issue #35） -->
            <LinearLayout
                android:id="@+id/emptyView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <!-- ボタンに見えないよう、小さく控えめな色の絵にする（#89） -->
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:alpha="0.6"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mic"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/empty_list"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/empty_list_sub"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

        </FrameLayout>

        <!-- 文字入力はなくし、マイクだけにする（issue #45）。聞き取り中はその上に状態と候補の数を出す -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/listeningPill"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="18dp"
                android:visibility="gone">

                <View
                    android:id="@+id/listeningDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/listening" />

                <TextView
                    android:id="@+id/listeningText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/buttonListen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/action_listen"
                android:src="@drawable/ic_mic"
                app:backgroundTint="?attr/colorPrimary"
                app:elevation="4dp"
                app:fabCustomSize="76dp"
                app:maxImageSize="34dp"
                app:shapeAppearanceOverlay="@style/MimiMemo.Circle"
                app:tint="?attr/colorOnPrimary" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
