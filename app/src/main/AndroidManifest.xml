<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 聞き取り（機能1）に使う。初回起動時に実行時パーミッションを要求する -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 画面を閉じても聞き取りを続けるための前面サービスと、その「聞き取り中」の通知（issue #44） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 朝の期限のお知らせを、再起動のあとも予約し直す（#100） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 振ってまとめたことを震えて知らせる（#146） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Android 11 以降で音声認識サービス・読み上げエンジンを見つけるために必要 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MimiMemo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 回転などで作り直すと、開いている詳細ダイアログが消えるため自分で処理する。通知から開いたときは同じ画面を使う -->
        <activity
            android:name=".ListeningActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:label="@string/title_listening"
            android:launchMode="singleTop"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <!--
            ほかのアプリの文章を共有すると ToDo 候補にする（#93）。
            公開するのはこの入口だけ。ここから来たときは聞き取りを始めない（#95）
        -->
        <!-- 朝の期限のお知らせ（#100） -->
        <receiver
            android:name=".MorningReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- ホーム画面ウィジェット（#97） -->
        <receiver
            android:name=".TodoWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_todo_info" />
        </receiver>
        <activity-alias
            android:name=".ShareTarget"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".ListeningActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>
        <service
            android:name=".ListeningService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- 端末内 AI は別プロセスで動かす。メモリ不足で止められても聞き取りは止まらない（#148） -->
        <service
            android:name=".LlmService"
            android:exported="false"
            android:process=":llm" />
        <!-- クイック設定の「ミミメモ」タイル（#85） -->
        <service
            android:name=".ListeningTileService"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <activity
            android:name=".TodoEditActivity"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SummaryActivity"
            android:label="@string/title_summary"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".SettingsActivity"
            android:label="@string/title_settings"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
